# /etc/trackstar/trackstar.env — read by systemd (EnvironmentFile). KEY=value, no quotes.

# Address to listen on. Use 127.0.0.1:3000 when a reverse proxy or cloudflared
# runs on the same machine, 0.0.0.0:3000 to be reachable on the LAN.
TRACKSTAR_ADDR=0.0.0.0:3000

# Writable state directory (database, generated session secret).
TRACKSTAR_DATA_DIR=/var/lib/trackstar

# "sqlite" is the only driver today; "postgres" is reserved.
TRACKSTAR_DATABASE_DRIVER=sqlite
TRACKSTAR_DATABASE_URL=/var/lib/trackstar/trackstar.db

# The URL users type into their browser. https:// here makes session cookies
# Secure and is what cross-origin checks compare against.
TRACKSTAR_PUBLIC_URL=https://track.example.com/

# Set to false once your accounts exist. The very first account can always be
# created and becomes the administrator.
TRACKSTAR_ALLOW_REGISTRATION=true

# At least 32 characters. setup.sh generates one; if left empty the server
# generates and stores one in $TRACKSTAR_DATA_DIR/session_secret.
TRACKSTAR_SESSION_SECRET=

# debug | info | warn | error
TRACKSTAR_LOG_LEVEL=info

# IANA zone that decides where iteration boundaries (midnights) fall.
TRACKSTAR_TIMEZONE=UTC

# Proxies whose CF-Connecting-IP / X-Forwarded-For headers are believed,
# comma-separated IPs or CIDRs. Requests from anyone else have these headers
# ignored. Add the address of the machine running cloudflared/nginx if it is
# not this one. "none" trusts nobody.
TRACKSTAR_TRUSTED_PROXIES=127.0.0.0/8,::1/128
